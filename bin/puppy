#!/usr/bin/env bash
set -euo pipefail

# puppy — global entry point of the tool, callable from any repo.
# A "pup" is a worker: a Claude Code agent running isolated in its own
# git worktree, launched and supervised by the main puppy (this agent).
# A "session" is a named main-agent (puppy itself) conversation — separate
# from pups, registered in data/sessions/<name>.json.
#
# usage:
#   puppy start [<name>] [--fresh]
#   puppy stop [<name>]
#   puppy forget <name> [--force]
#   puppy spawn <pup-id> <repo-path> <branch> <prompt...>
#   puppy pr <pup-id> [-- <extra gh pr create args>]
#   puppy rm <pup-id> [--force]
#   puppy supervise [pup-id ...]
#   puppy ls
#   puppy status <pup-id>
#   puppy watchers
#   puppy tell <pup-id> <text>
#   puppy usage

puppy_dir="$HOME/puppy"
bin="$puppy_dir/bin"

cmd="${1:-}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  start)
    fresh=0
    name=""
    for arg in "$@"; do
      case "$arg" in
        --fresh) fresh=1 ;;
        --resume) ;; # kept as a no-op for old muscle memory; resume is the only non-fresh mode now
        *) name="$arg" ;;
      esac
    done

    if [[ -z "$name" ]]; then
      if [[ -t 0 && -t 1 ]]; then
        # Interactive picker: list known named sessions (main-agent only,
        # never pups), most-recently-started first, plus an option to
        # create a new one.
        rows=()
        while IFS= read -r line; do
          [[ -n "$line" ]] && rows+=("$line")
        done < <("$bin/sessions.sh" list)
        if [[ "${#rows[@]}" -eq 0 ]]; then
          name="puppy"
        else
          echo "Sesiones de Puppy:"
          i=1
          for row in "${rows[@]}"; do
            IFS=$'\t' read -r r_name r_sid r_status r_ws r_num r_agent r_last <<< "$row"
            if [[ "$r_status" == "open" ]]; then
              echo "  $i) $r_name — abierta (posición $r_num, $r_agent)"
            else
              echo "  $i) $r_name — cerrada (última vez: $r_last)"
            fi
            i=$((i + 1))
          done
          echo "  n) nueva sesión"
          read -r -p "Elige una sesión [1]: " choice
          choice="${choice:-1}"
          if [[ "$choice" == "n" || "$choice" == "N" ]]; then
            read -r -p "Nombre de la nueva sesión: " name
            if [[ -z "$name" ]]; then
              echo "error: nombre vacío" >&2
              exit 1
            fi
          elif [[ "$choice" =~ ^[0-9]+$ && "$choice" -ge 1 && "$choice" -le "${#rows[@]}" ]]; then
            IFS=$'\t' read -r name _ <<< "${rows[$((choice - 1))]}"
          else
            echo "error: opción inválida" >&2
            exit 1
          fi
        fi
      else
        # Non-tty: preserve today's implicit contract for any existing
        # automation calling bare `puppy start`.
        name="puppy"
      fi
    fi

    start_args=("$name")
    [[ "$fresh" -eq 1 ]] && start_args+=(--fresh)
    "$bin/sessions.sh" start "${start_args[@]}"

    # If this terminal isn't already attached to herdr (e.g. it was called
    # from a plain Terminal.app), attach it now: this way the user sees the
    # herdr window with the session workspace already focused, instead of
    # having to go find it manually. If we're already inside a herdr pane
    # (HERDR_ENV=1, e.g. calling `puppy start` from another pup), it's not
    # needed.
    if [[ -z "${HERDR_ENV:-}" ]]; then
      exec herdr
    fi
    ;;
  stop)
    if [[ $# -ge 1 ]]; then
      "$bin/sessions.sh" stop "$1"
    else
      rows=()
      while IFS= read -r line; do
        [[ -n "$line" ]] && rows+=("$line")
      done < <("$bin/sessions.sh" list | awk -F'\t' '$3=="open"')
      if [[ "${#rows[@]}" -eq 0 ]]; then
        echo "No hay sesión de Puppy abierta."
        exit 0
      elif [[ "${#rows[@]}" -eq 1 ]]; then
        IFS=$'\t' read -r only_name _ <<< "${rows[0]}"
        "$bin/sessions.sh" stop "$only_name"
      else
        names=()
        for row in "${rows[@]}"; do
          IFS=$'\t' read -r r_name _ <<< "$row"
          names+=("$r_name")
        done
        joined=""
        for n in "${names[@]}"; do
          joined="${joined:+$joined, }$n"
        done
        echo "hay varias sesiones de puppy abiertas ($joined) — usa 'puppy stop <name>'" >&2
        exit 1
      fi
    fi
    ;;
  forget)
    if [[ $# -lt 1 ]]; then
      echo "uso: puppy forget <name> [--force]" >&2
      exit 1
    fi
    exec "$bin/sessions.sh" forget "$@"
    ;;
  spawn)
    exec "$bin/spawn-pup.sh" "$@"
    ;;
  pr)
    exec "$bin/open-pr.sh" "$@"
    ;;
  rm)
    exec "$bin/remove-pup.sh" "$@"
    ;;
  supervise)
    exec "$bin/supervise.sh" "$@"
    ;;
  ls)
    all_panes=$(herdr pane list 2>/dev/null || echo '{}')

    session_rows=()
    while IFS= read -r line; do
      [[ -n "$line" ]] && session_rows+=("$line")
    done < <("$bin/sessions.sh" list)
    if [[ "${#session_rows[@]}" -eq 0 ]]; then
      echo "Puppy: cerrado (sin sesiones registradas)"
    else
      printf "%-16s %-8s %-8s %-8s %s\n" "SESIÓN" "ESTADO" "LIVE" "POSICIÓN" "DETALLE"
      for row in "${session_rows[@]}"; do
        IFS=$'\t' read -r s_name s_sid s_status s_ws s_num s_agent s_last <<< "$row"
        if [[ "$s_status" == "open" ]]; then
          printf "%-16s %-8s %-8s %-8s workspace %s\n" "$s_name" "abierta" "$s_agent" "$s_num" "$s_ws"
        else
          printf "%-16s %-8s %-8s %-8s última vez: %s\n" "$s_name" "cerrada" "-" "-" "$s_last"
        fi
      done
    fi

    usage_line=$("$bin/usage.sh" --pct 2>/dev/null || echo "|||")
    IFS='|' read -r five_pct week_pct five_left week_left <<< "$usage_line"
    if [[ -n "$five_pct" || -n "$week_pct" ]]; then
      if [[ -t 1 ]]; then
        GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; RESET=$'\033[0m'
      else
        GREEN=""; YELLOW=""; RED=""; RESET=""
      fi
      pct_color() {
        local p="${1:-0}"
        if (( p >= 80 )); then echo "$RED"
        elif (( p >= 50 )); then echo "$YELLOW"
        else echo "$GREEN"
        fi
      }
      echo "Suscripción: 5h $(pct_color "${five_pct:-0}")${five_pct:-?}%${RESET}${five_left:+ (${five_left})} · 7d $(pct_color "${week_pct:-0}")${week_pct:-?}%${RESET}${week_left:+ (${week_left})}"
    fi
    echo

    tasks_dir="$puppy_dir/data/tasks"
    if [[ ! -d "$tasks_dir" ]] || [[ -z "$(ls -A "$tasks_dir" 2>/dev/null)" ]]; then
      echo "No hay pups registrados."
      exit 0
    fi
    printf "%-20s %-10s %-10s %-30s %-14s %s\n" "PUP" "ESTADO" "LIVE" "REPO#BRANCH" "PR" "PREVIEW"
    for f in "$tasks_dir"/*.json; do
      task_id=$(jq -r '.task_id' "$f")
      status=$(jq -r '.status' "$f")
      repo_branch=$(jq -r '(.repo | split("/") | last) + "#" + .branch' "$f")
      pane_id=$(jq -r '.pane_id // empty' "$f")
      pr=$(jq -r 'if .pr.number then "#\(.pr.number) \(.pr.state)" else "-" end' "$f")

      live="-"
      preview="-"
      if [[ -n "$pane_id" ]]; then
        pup_pane=$(echo "$all_panes" | jq -r --arg p "$pane_id" '.result.panes[]? | select(.pane_id==$p)')
        if [[ -n "$pup_pane" ]]; then
          live=$(echo "$pup_pane" | jq -r '.agent_status // "unknown"')
          preview=$(echo "$pup_pane" | jq -r '.terminal_title_stripped // "-"')
        fi
      fi
      printf "%-20s %-10s %-10s %-30s %-14s %s\n" "$task_id" "$status" "$live" "$repo_branch" "$pr" "$preview"
    done
    ;;
  status)
    if [[ $# -lt 1 ]]; then
      echo "uso: puppy status <pup-id>" >&2
      exit 1
    fi
    jq . "$puppy_dir/data/tasks/$1.json"
    ;;
  watchers)
    exec "$bin/watchers.sh" "$@"
    ;;
  tell)
    if [[ $# -lt 2 ]]; then
      echo "uso: puppy tell <pup-id> <text>" >&2
      exit 1
    fi
    pup_id=$1; shift
    task_file="$puppy_dir/data/tasks/$pup_id.json"
    if [[ ! -f "$task_file" ]]; then
      echo "error: no existe $task_file" >&2
      exit 1
    fi
    pane_id=$(jq -r '.pane_id // empty' "$task_file")
    if [[ -z "$pane_id" ]]; then
      echo "error: no hay pane_id registrado para '$pup_id'" >&2
      exit 1
    fi
    herdr agent prompt "$pane_id" "$*"
    ;;
  usage)
    exec "$bin/usage.sh" "$@"
    ;;
  *)
    cat >&2 <<'EOF'
uso: puppy <comando> [args]

comandos:
  start [<name>] [--fresh]                            abre (o enfoca) una sesión nombrada del puppy principal;
                                                       sin nombre y en tty, muestra un picker con las sesiones
                                                       registradas; sin tty, usa "puppy" por defecto
  stop [<name>]                                        termina esa sesión y cierra su workspace (el registro
                                                       queda, sigue siendo reanudable); sin nombre, sólo si hay
                                                       exactamente una sesión abierta
  forget <name> [--force]                              detiene la sesión (si está abierta) y borra su registro
                                                       data/sessions/<name>.json; en tty pide confirmación, si no
                                                       requiere --force
  spawn <pup-id> <repo-path> <branch> <prompt...>   lanza un pup (worktree + worker)
  pr <pup-id> [-- args de gh pr create]             pushea y abre PR
  rm <pup-id> [--force]                             borra worktree + registro del pup
  supervise [pup-id ...]                             espera (sondeo) a que resuelva algún pup
  ls                                                  lista sesiones registradas + pups registrados
  status <pup-id>                                     muestra la metadata completa de un pup
  watchers                                            lista watch-pup.sh vivos y detecta huérfanos
  tell <pup-id> <text>                                envía una instrucción de seguimiento a un pup en marcha
  usage                                                muestra el uso de la suscripción Claude Pro (5h/7d)
EOF
    exit 1
    ;;
esac
