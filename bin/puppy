#!/usr/bin/env bash
set -euo pipefail

# puppy — global entry point of the tool, callable from any repo.
# A "pup" is a worker: a Claude Code agent running isolated in its own
# git worktree, launched and supervised by the main puppy (this agent).
#
# usage:
#   puppy start [--resume|--fresh]
#   puppy stop
#   puppy spawn <pup-id> <repo-path> <branch> <prompt...>
#   puppy pr <pup-id> [-- <extra gh pr create args>]
#   puppy rm <pup-id> [--force]
#   puppy supervise [pup-id ...]
#   puppy ls
#   puppy status <pup-id>
#   puppy watchers
#   puppy tell <pup-id> <text>
#   puppy usage

puppy_dir="$HOME/puppy"
bin="$puppy_dir/bin"

cmd="${1:-}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  start)
    mode=""
    for arg in "$@"; do
      case "$arg" in
        --fresh) mode="fresh" ;;
        --resume) mode="resume" ;;
      esac
    done

    existing_ws=$(herdr workspace list | jq -r '.result.workspaces[] | select(.label=="puppy") | .workspace_id' | head -1)

    # If the mode wasn't forced by a flag, ask (only if there's someone
    # to ask: an interactive terminal). In non-interactive mode, default
    # to resume so automations don't break.
    if [[ -z "$mode" ]]; then
      if [[ -t 0 && -t 1 ]]; then
        if [[ -n "$existing_ws" ]]; then
          read -r -p "Puppy ya está abierto (workspace $existing_ws). ¿Reanudar [r] o cerrarlo y empezar de cero [c]? [r]: " answer
        else
          read -r -p "No hay workspace abierto, pero sí historial en disco. ¿Reanudar esa conversación [r] o empezar de cero [c]? [r]: " answer
        fi
        case "$answer" in
          c|C|cerrar|close|fresh) mode="fresh" ;;
          *) mode="resume" ;;
        esac
      else
        mode="resume"
      fi
    fi

    if [[ "$mode" == "fresh" && -n "$existing_ws" ]]; then
      echo "Cerrando workspace previo de Puppy ($existing_ws)..."
      herdr workspace close "$existing_ws" >/dev/null 2>&1 || true
      existing_ws=""
    fi

    if [[ "$mode" == "resume" && -n "$existing_ws" ]]; then
      herdr workspace focus "$existing_ws" >/dev/null
      echo "Puppy ya estaba abierto (workspace $existing_ws), lo he enfocado."
    else
      ws_json=$(herdr workspace create --cwd "$puppy_dir" --label puppy --focus)
      if echo "$ws_json" | jq -e '.error' >/dev/null 2>&1; then
        echo "error creando el workspace de Puppy: $(echo "$ws_json" | jq -r '.error.message')" >&2
        exit 1
      fi
      ws_id=$(echo "$ws_json" | jq -r '.result.workspace.workspace_id // .result.workspace_id')
      pane_id=$(echo "$ws_json" | jq -r '.result.pane.pane_id // .result.root_pane.pane_id')

      started=0
      for attempt in 1 2 3 4 5; do
        if [[ "$mode" == "fresh" ]]; then
          agent_ok=$(herdr agent start puppy --kind claude --pane "$pane_id" >/dev/null 2>&1 && echo 1 || echo 0)
        else
          agent_ok=$(herdr agent start puppy --kind claude --pane "$pane_id" -- --continue >/dev/null 2>&1 && echo 1 || echo 0)
        fi
        if [[ "$agent_ok" == "1" ]]; then
          started=1
          break
        fi
        sleep 1
      done
      if [[ "$started" -ne 1 ]]; then
        echo "error: workspace creado (id $ws_id) pero no se pudo arrancar Claude Code en el pane $pane_id" >&2
        exit 1
      fi
      echo "Puppy arrancado en workspace $ws_id (pane $pane_id), cwd=$puppy_dir"
    fi

    # If this terminal isn't already attached to herdr (e.g. it was called
    # from a plain Terminal.app), attach it now: this way the user sees the
    # herdr window with the puppy workspace already focused, instead of
    # having to go find it manually. If we're already inside a herdr pane
    # (HERDR_ENV=1, e.g. calling `puppy start` from another pup), it's not
    # needed.
    if [[ -z "${HERDR_ENV:-}" ]]; then
      exec herdr
    fi
    ;;
  stop)
    existing_ws=$(herdr workspace list | jq -r '.result.workspaces[] | select(.label=="puppy") | .workspace_id' | head -1)
    if [[ -z "$existing_ws" ]]; then
      echo "No hay sesión de Puppy abierta."
      exit 0
    fi

    pane_id=$(herdr pane list --workspace "$existing_ws" 2>/dev/null | jq -r '.result.panes[0].pane_id // empty')
    if [[ -n "$pane_id" ]]; then
      pid=$(herdr pane process-info --pane "$pane_id" 2>/dev/null \
        | jq -r '.result.process_info.foreground_processes[]? | select(.name=="claude") | .pid' | head -1)
      if [[ -n "$pid" ]]; then
        kill "$pid" 2>/dev/null || true
      fi
    fi

    herdr workspace close "$existing_ws" >/dev/null 2>&1 || true
    echo "Puppy detenido (workspace $existing_ws cerrado)."
    ;;
  spawn)
    exec "$bin/spawn-pup.sh" "$@"
    ;;
  pr)
    exec "$bin/open-pr.sh" "$@"
    ;;
  rm)
    exec "$bin/remove-pup.sh" "$@"
    ;;
  supervise)
    exec "$bin/supervise.sh" "$@"
    ;;
  ls)
    all_panes=$(herdr pane list 2>/dev/null || echo '{}')

    ws_id=$(herdr workspace list 2>/dev/null | jq -r '.result.workspaces[] | select(.label=="puppy") | .workspace_id' | head -1)
    if [[ -n "$ws_id" ]]; then
      pane_info=$(echo "$all_panes" | jq -c --arg w "$ws_id" '.result.panes[]? | select(.workspace_id==$w)' | head -1)
      live=$(echo "$pane_info" | jq -r '.agent_status // "unknown"' 2>/dev/null)
      preview=$(echo "$pane_info" | jq -r '.terminal_title_stripped // empty' 2>/dev/null)
      echo "Puppy: ${live:-unknown} (workspace $ws_id)${preview:+ — \"$preview\"}"
    else
      echo "Puppy: cerrado (sin workspace abierto)"
    fi

    usage_line=$("$bin/usage.sh" --pct 2>/dev/null || echo "|||")
    IFS='|' read -r five_pct week_pct five_left week_left <<< "$usage_line"
    if [[ -n "$five_pct" || -n "$week_pct" ]]; then
      if [[ -t 1 ]]; then
        GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; RESET=$'\033[0m'
      else
        GREEN=""; YELLOW=""; RED=""; RESET=""
      fi
      pct_color() {
        local p="${1:-0}"
        if (( p >= 80 )); then echo "$RED"
        elif (( p >= 50 )); then echo "$YELLOW"
        else echo "$GREEN"
        fi
      }
      echo "Suscripción: 5h $(pct_color "${five_pct:-0}")${five_pct:-?}%${RESET}${five_left:+ (${five_left})} · 7d $(pct_color "${week_pct:-0}")${week_pct:-?}%${RESET}${week_left:+ (${week_left})}"
    fi
    echo

    tasks_dir="$puppy_dir/data/tasks"
    if [[ ! -d "$tasks_dir" ]] || [[ -z "$(ls -A "$tasks_dir" 2>/dev/null)" ]]; then
      echo "No hay pups registrados."
      exit 0
    fi
    printf "%-20s %-10s %-10s %-30s %-14s %s\n" "PUP" "ESTADO" "LIVE" "REPO#BRANCH" "PR" "PREVIEW"
    for f in "$tasks_dir"/*.json; do
      task_id=$(jq -r '.task_id' "$f")
      status=$(jq -r '.status' "$f")
      repo_branch=$(jq -r '(.repo | split("/") | last) + "#" + .branch' "$f")
      pane_id=$(jq -r '.pane_id // empty' "$f")
      pr=$(jq -r 'if .pr.number then "#\(.pr.number) \(.pr.state)" else "-" end' "$f")

      live="-"
      preview="-"
      if [[ -n "$pane_id" ]]; then
        pup_pane=$(echo "$all_panes" | jq -r --arg p "$pane_id" '.result.panes[]? | select(.pane_id==$p)')
        if [[ -n "$pup_pane" ]]; then
          live=$(echo "$pup_pane" | jq -r '.agent_status // "unknown"')
          preview=$(echo "$pup_pane" | jq -r '.terminal_title_stripped // "-"')
        fi
      fi
      printf "%-20s %-10s %-10s %-30s %-14s %s\n" "$task_id" "$status" "$live" "$repo_branch" "$pr" "$preview"
    done
    ;;
  status)
    if [[ $# -lt 1 ]]; then
      echo "uso: puppy status <pup-id>" >&2
      exit 1
    fi
    jq . "$puppy_dir/data/tasks/$1.json"
    ;;
  watchers)
    exec "$bin/watchers.sh" "$@"
    ;;
  tell)
    if [[ $# -lt 2 ]]; then
      echo "uso: puppy tell <pup-id> <text>" >&2
      exit 1
    fi
    pup_id=$1; shift
    task_file="$puppy_dir/data/tasks/$pup_id.json"
    if [[ ! -f "$task_file" ]]; then
      echo "error: no existe $task_file" >&2
      exit 1
    fi
    pane_id=$(jq -r '.pane_id // empty' "$task_file")
    if [[ -z "$pane_id" ]]; then
      echo "error: no hay pane_id registrado para '$pup_id'" >&2
      exit 1
    fi
    herdr agent prompt "$pane_id" "$*"
    ;;
  usage)
    exec "$bin/usage.sh" "$@"
    ;;
  *)
    cat >&2 <<'EOF'
uso: puppy <comando> [args]

comandos:
  start [--resume|--fresh]                            abre (o enfoca) la sesión del puppy principal;
                                                       sin flag pregunta si hay sesión previa que reanudar
  stop                                                 termina el proceso de puppy y cierra su workspace
  spawn <pup-id> <repo-path> <branch> <prompt...>   lanza un pup (worktree + worker)
  pr <pup-id> [-- args de gh pr create]             pushea y abre PR
  rm <pup-id> [--force]                             borra worktree + registro del pup
  supervise [pup-id ...]                             espera (sondeo) a que resuelva algún pup
  ls                                                  lista pups registrados + estado de la sesión de puppy
  status <pup-id>                                     muestra la metadata completa de un pup
  watchers                                            lista watch-pup.sh vivos y detecta huérfanos
  tell <pup-id> <text>                                envía una instrucción de seguimiento a un pup en marcha
  usage                                                muestra el uso de la suscripción Claude Pro (5h/7d)
EOF
    exit 1
    ;;
esac
