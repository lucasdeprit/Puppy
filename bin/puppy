#!/usr/bin/env bash
set -euo pipefail

# puppy — global entry point of the tool, callable from any repo.
# A "pup" is a worker: a Claude Code agent running isolated in its own
# git worktree, launched and supervised by the main puppy (this agent).
#
# puppy's own installation (this file, bin/, AGENTS.md) is fixed at a
# single location, self-located below. The *project* it orchestrates over
# is per-session (see bin/lib/project.sh) — by default the cwd `puppy
# start` was run from — so multiple projects can each have their own
# concurrent puppy session and their own pup state.
#
# usage:
#   puppy start [project-dir] [--resume|--fresh]
#   puppy stop [project-dir]
#   puppy spawn <pup-id> <repo-path> <branch> <prompt...>
#   puppy pr <pup-id> [--all] [-- <extra gh pr create args>]
#   puppy rm <pup-id> [--force] [--all]
#   puppy supervise [--all] [pup-id ...]
#   puppy ls [--all]
#   puppy status <pup-id> [--all]
#   puppy watchers
#   puppy tell <pup-id> [--all] <text>
#   puppy usage
#
# By default, commands that operate on a specific pup (status/tell/pr/rm/
# supervise) and the pup table in `ls` only look in the active project's
# data; pass --all to search across every project's (see "Persistent state"
# in AGENTS.md).

puppy_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
bin="$puppy_dir/bin"
source "$bin/lib/project.sh"

# puppy_pick_project_dir — interactive picker for `puppy start` when it's
# called with no project-dir argument from a real terminal. Lists every known
# puppy session (via puppy_list_sessions — open now or just with saved data),
# numbered, and lets the user either pick one by number or type a path to
# open/create a new project. That "type a free path" option is specific to
# `puppy start` (you can always open/create a project by path), so this stays
# its own function rather than a thin wrapper over puppy_pick_session, which
# doesn't offer it. Prints the chosen absolute project dir on stdout; all
# prompts/listing go to stderr so this composes with
# `project_dir=$(puppy_pick_project_dir)`.
puppy_pick_project_dir() {
  local -a slugs=()
  local -a paths=()
  local idx=1

  echo "Sesiones de Puppy conocidas:" >&2

  local line rest slug path ws_id alive has_history status_txt
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    rest="$line"
    slug="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    path="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    ws_id="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    alive="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
    has_history="$rest"

    if [[ -n "$ws_id" ]]; then
      if [[ "$alive" == "1" ]]; then
        status_txt="abierto, vivo"
      else
        status_txt="abierto, sin proceso claude"
      fi
    else
      status_txt="cerrado"
    fi

    slugs[$idx]="$slug"
    paths[$idx]="$path"
    if [[ -n "$path" ]]; then
      printf "  %d) [%s] %s — %s\n" "$idx" "$status_txt" "$slug" "$path" >&2
    else
      printf "  %d) [%s] %s (ruta desconocida)\n" "$idx" "$status_txt" "$slug" >&2
    fi
    idx=$((idx + 1))
  done < <(puppy_list_sessions)

  if [[ "$idx" -eq 1 ]]; then
    echo "  (ninguna todavía)" >&2
  fi
  echo >&2

  local answer chosen
  read -r -p "Elige un número para abrir esa sesión, o escribe una ruta para un proyecto nuevo/existente: " answer

  if [[ "$answer" =~ ^[0-9]+$ ]]; then
    if [[ -z "${paths[$answer]+set}" ]]; then
      echo "error: no existe la opción $answer." >&2
      return 1
    fi
    chosen="${paths[$answer]}"
    if [[ -z "$chosen" ]]; then
      echo "error: no se conoce la ruta original de esa sesión; abrila pasándole el directorio directamente a 'puppy start <dir>'." >&2
      return 1
    fi
    if [[ ! -d "$chosen" ]]; then
      echo "error: esa sesión ya no tiene una ruta válida en disco ($chosen no existe); usá 'puppy forget --slug ${slugs[$answer]}' si querés olvidarla." >&2
      return 1
    fi
    (cd "$chosen" && pwd -P)
    return 0
  fi

  if [[ -z "$answer" ]]; then
    echo "error: no se eligió ningún proyecto." >&2
    return 1
  fi

  if [[ ! -d "$answer" ]]; then
    echo "error: '$answer' no es un directorio." >&2
    return 1
  fi

  (cd "$answer" && pwd -P)
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  start)
    mode=""
    project_arg=""
    for arg in "$@"; do
      case "$arg" in
        --fresh) mode="fresh" ;;
        --resume) mode="resume" ;;
        *) project_arg="$arg" ;;
      esac
    done

    # Only offer the interactive picker for the bare "no directory argument"
    # case, and only when there's a real terminal to drive it — an explicit
    # `puppy start <dir>` or a non-interactive call keeps operating directly
    # on that dir (or $PWD) exactly as before.
    if [[ -z "$project_arg" && -t 0 && -t 1 ]]; then
      project_dir=$(puppy_pick_project_dir) || exit 1
    else
      project_dir="$(cd "${project_arg:-$PWD}" && pwd -P)"
    fi
    slug=$(puppy_project_slug "$project_dir")
    label="puppy-$slug"

    # Register the project unconditionally as soon as we know we're really
    # opening/focusing a session for it — not just when a pup happens to get
    # spawned later. Otherwise a project where you only ever talk to Puppy
    # without spawning any pup never gets a data dir or recorded path, and
    # silently drops out of the start picker the moment its workspace closes.
    puppy_data_dir "$project_dir" >/dev/null

    if [[ ! -d "$project_dir/.claude" ]]; then
      echo "aviso: $project_dir no tiene carpeta .claude" >&2
    fi

    existing_ws=$(puppy_find_workspace_by_label "$label")

    # A herdr workspace can outlive the claude process that ran in it (it
    # crashed, or was killed, without herdr closing the pane/workspace).
    # Treat that as if there were no workspace at all rather than focusing a
    # dead pane as though it were a live session.
    if [[ -n "$existing_ws" ]] && ! puppy_workspace_alive "$existing_ws"; then
      echo "El workspace previo de Puppy ($existing_ws) ya no tiene un proceso claude vivo; lo cierro y sigo como si no existiera."
      herdr workspace close "$existing_ws" >/dev/null 2>&1 || true
      existing_ws=""
    fi

    has_history=0
    puppy_claude_history_exists "$project_dir" && has_history=1

    # If the mode wasn't forced by a flag, ask (only if there's someone to
    # ask: an interactive terminal). In non-interactive mode, default to
    # resume only if there's an actual conversation to resume (a live
    # workspace or saved Claude Code history on disk) so automations don't
    # break; otherwise there's nothing to resume, so start fresh.
    if [[ -z "$mode" ]]; then
      if [[ -t 0 && -t 1 ]]; then
        if [[ -n "$existing_ws" ]]; then
          read -r -p "Puppy ya está abierto para $project_dir (workspace $existing_ws). ¿Reanudar [r] o cerrarlo y empezar de cero [c]? [r]: " answer
          case "$answer" in
            c|C|cerrar|close|fresh) mode="fresh" ;;
            *) mode="resume" ;;
          esac
        elif [[ "$has_history" -eq 1 ]]; then
          read -r -p "No hay workspace abierto para $project_dir, pero sí historial en disco. ¿Reanudar esa conversación [r] o empezar de cero [c]? [r]: " answer
          case "$answer" in
            c|C|cerrar|close|fresh) mode="fresh" ;;
            *) mode="resume" ;;
          esac
        else
          echo "No hay workspace abierto ni historial en disco para $project_dir; arranco una conversación nueva."
          mode="fresh"
        fi
      else
        if [[ -n "$existing_ws" || "$has_history" -eq 1 ]]; then
          mode="resume"
        else
          mode="fresh"
        fi
      fi
    fi

    if [[ "$mode" == "fresh" && -n "$existing_ws" ]]; then
      echo "Cerrando workspace previo de Puppy ($existing_ws)..."
      herdr workspace close "$existing_ws" >/dev/null 2>&1 || true
      existing_ws=""
    fi

    if [[ "$mode" == "resume" && -n "$existing_ws" ]]; then
      herdr workspace focus "$existing_ws" >/dev/null
      echo "Puppy ya estaba abierto (workspace $existing_ws) para $project_dir, lo he enfocado."
    else
      # Two near-simultaneous `puppy start` calls for the same project can
      # both pass the "no existing workspace" check above before either
      # finishes creating one. Re-check right before creating so we don't
      # end up with two workspaces sharing the same label.
      race_ws=$(puppy_find_workspace_by_label "$label")
      if [[ -n "$race_ws" ]]; then
        herdr workspace focus "$race_ws" >/dev/null
        echo "Puppy ya se estaba iniciando en paralelo (workspace $race_ws) para $project_dir, lo he enfocado."
      else
        # mode="resume" can happen (user's choice, an explicit --resume
        # flag, or the non-interactive default) even when there's nothing
        # real to continue — e.g. --resume passed by hand with no history
        # and no live workspace. Base the actual --continue/identity-prompt
        # decision on whether there's genuine history, not on the mode
        # label, so we never leave a plain, identity-less Claude Code
        # running under a "resume" that resumed nothing.
        real_resume=0
        [[ "$mode" == "resume" && "$has_history" -eq 1 ]] && real_resume=1
        if [[ "$mode" == "resume" && "$real_resume" -ne 1 ]]; then
          echo "No hay ninguna conversación real para reanudar en $project_dir; arranco una nueva."
        fi

        ws_json=$(herdr workspace create --cwd "$project_dir" --env "PUPPY_PROJECT_DIR=$project_dir" --label "$label" --focus)
        if echo "$ws_json" | jq -e '.error' >/dev/null 2>&1; then
          echo "error creando el workspace de Puppy: $(echo "$ws_json" | jq -r '.error.message')" >&2
          exit 1
        fi
        ws_id=$(echo "$ws_json" | jq -r '.result.workspace.workspace_id // .result.workspace_id')
        pane_id=$(echo "$ws_json" | jq -r '.result.pane.pane_id // .result.root_pane.pane_id')

        started=0
        for attempt in 1 2 3 4 5; do
          if [[ "$real_resume" -eq 1 ]]; then
            agent_ok=$(herdr agent start "$label" --kind claude --pane "$pane_id" -- --continue >/dev/null 2>&1 && echo 1 || echo 0)
          else
            agent_ok=$(herdr agent start "$label" --kind claude --pane "$pane_id" >/dev/null 2>&1 && echo 1 || echo 0)
          fi
          if [[ "$agent_ok" == "1" ]]; then
            started=1
            break
          fi
          sleep 1
        done
        if [[ "$started" -ne 1 ]]; then
          echo "error: workspace creado (id $ws_id) pero no se pudo arrancar Claude Code en el pane $pane_id" >&2
          exit 1
        fi
        echo "Puppy arrancado en workspace $ws_id (pane $pane_id), cwd=$project_dir"

        # Only a truly new conversation needs the identity/rules message
        # sent explicitly: on a real --continue resume it's already in the
        # history being resumed.
        if [[ "$real_resume" -ne 1 ]]; then
          init_prompt="Leé $puppy_dir/AGENTS.md y seguilo — tiene tu rol, tus reglas y tus comandos. Tu proyecto activo en esta sesión es $project_dir."
          prompted=0
          for attempt in 1 2 3 4 5; do
            if herdr agent prompt "$pane_id" "$init_prompt" --wait --until working --timeout 5000 >/dev/null 2>&1; then
              prompted=1
              break
            fi
            sleep 1
          done
          if [[ "$prompted" -ne 1 ]]; then
            echo "aviso: no se pudo enviar el mensaje inicial de rol al pane $pane_id tras varios intentos" >&2
          fi
        fi
      fi
    fi

    # If this terminal isn't already attached to herdr (e.g. it was called
    # from a plain Terminal.app), attach it now: this way the user sees the
    # herdr window with the puppy workspace already focused, instead of
    # having to go find it manually. If we're already inside a herdr pane
    # (HERDR_ENV=1, e.g. calling `puppy start` from another pup), it's not
    # needed.
    if [[ -z "${HERDR_ENV:-}" ]]; then
      exec herdr
    fi
    ;;
  stop)
    if [[ $# -eq 0 && -t 0 && -t 1 ]]; then
      slug=$(puppy_pick_session --open) || exit 1
    else
      project_dir="$(cd "${1:-$PWD}" && pwd -P)"
      slug=$(puppy_project_slug "$project_dir")
    fi
    label="puppy-$slug"

    existing_ws=$(puppy_find_workspace_by_label "$label")
    if [[ -z "$existing_ws" ]]; then
      echo "No hay sesión de Puppy abierta para ${project_dir:-$slug}."
      exit 0
    fi

    pane_id=$(puppy_workspace_first_pane "$existing_ws")
    if [[ -n "$pane_id" ]]; then
      pid=$(puppy_pane_claude_pid "$pane_id")
      if [[ -n "$pid" ]]; then
        kill "$pid" 2>/dev/null || true
      fi
    fi

    herdr workspace close "$existing_ws" >/dev/null 2>&1 || true
    echo "Puppy detenido (workspace $existing_ws cerrado)."
    ;;
  forget)
    exec "$bin/forget-project.sh" "$@"
    ;;
  spawn)
    exec "$bin/spawn-pup.sh" "$@"
    ;;
  pr)
    exec "$bin/open-pr.sh" "$@"
    ;;
  rm)
    exec "$bin/remove-pup.sh" "$@"
    ;;
  supervise)
    exec "$bin/supervise.sh" "$@"
    ;;
  ls)
    all=""
    for arg in "$@"; do
      [[ "$arg" == "--all" ]] && all="--all"
    done

    all_panes=$(herdr pane list 2>/dev/null || echo '{}')

    session_lines=$(puppy_list_sessions)
    if [[ -z "$session_lines" ]]; then
      echo "No hay ninguna sesión de Puppy conocida."
    else
      while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        rest="$line"
        slug="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
        path="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
        ws_id="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
        alive="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
        has_history="$rest"

        if [[ -n "$ws_id" ]]; then
          if [[ "$alive" == "1" ]]; then
            estado="vivo"
          else
            estado="abierto sin proceso claude (huérfano)"
          fi
          pane_info=$(echo "$all_panes" | jq -c --arg w "$ws_id" '.result.panes[]? | select(.workspace_id==$w)' | head -1)
          preview=$(echo "$pane_info" | jq -r '.terminal_title_stripped // empty' 2>/dev/null)
        else
          estado="cerrado"
          preview=""
        fi

        if [[ -n "$path" ]]; then
          ruta_txt=" — $path"
        else
          ruta_txt=" (sin ruta conocida)"
        fi
        echo "Puppy [$slug]: $estado$ruta_txt${preview:+ — \"$preview\"}"
      done <<< "$session_lines"
    fi

    usage_line=$("$bin/usage.sh" --pct 2>/dev/null || echo "|||")
    IFS='|' read -r five_pct week_pct five_left week_left <<< "$usage_line"
    if [[ -n "$five_pct" || -n "$week_pct" ]]; then
      if [[ -t 1 ]]; then
        GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; RESET=$'\033[0m'
      else
        GREEN=""; YELLOW=""; RED=""; RESET=""
      fi
      pct_color() {
        local p="${1:-0}"
        if (( p >= 80 )); then echo "$RED"
        elif (( p >= 50 )); then echo "$YELLOW"
        else echo "$GREEN"
        fi
      }
      echo "Suscripción: 5h $(pct_color "${five_pct:-0}")${five_pct:-?}%${RESET}${five_left:+ (${five_left})} · 7d $(pct_color "${week_pct:-0}")${week_pct:-?}%${RESET}${week_left:+ (${week_left})}"
    fi
    echo

    task_files=()
    while IFS= read -r d; do
      [[ -z "$d" ]] && continue
      for f in "$d"/tasks/*.json; do
        [[ -e "$f" ]] && task_files+=("$f")
      done
    done < <(puppy_data_dirs_for_scope "$all")

    if [[ ${#task_files[@]} -eq 0 ]]; then
      if [[ "$all" == "--all" ]]; then
        echo "No hay pups registrados."
      else
        echo "No hay pups registrados en el proyecto activo. Usa 'puppy ls --all' para ver los de todos los proyectos."
      fi
      exit 0
    fi
    printf "%-20s %-10s %-10s %-30s %-14s %-20s %s\n" "PUP" "ESTADO" "LIVE" "REPO#BRANCH" "PR" "PROYECTO" "PREVIEW"
    for f in "${task_files[@]}"; do
      task_id=$(jq -r '.task_id' "$f")
      status=$(jq -r '.status' "$f")
      repo_branch=$(jq -r '(.repo | split("/") | last) + "#" + .branch' "$f")
      pane_id=$(jq -r '.pane_id // empty' "$f")
      pr=$(jq -r 'if .pr.number then "#\(.pr.number) \(.pr.state)" else "-" end' "$f")
      project=$(jq -r 'if .project_dir then (.project_dir | split("/") | last) else "-" end' "$f")

      live="-"
      preview="-"
      if [[ -n "$pane_id" ]]; then
        pup_pane=$(echo "$all_panes" | jq -r --arg p "$pane_id" '.result.panes[]? | select(.pane_id==$p)')
        if [[ -n "$pup_pane" ]]; then
          live=$(echo "$pup_pane" | jq -r '.agent_status // "unknown"')
          preview=$(echo "$pup_pane" | jq -r '.terminal_title_stripped // "-"')
        fi
      fi
      printf "%-20s %-10s %-10s %-30s %-14s %-20s %s\n" "$task_id" "$status" "$live" "$repo_branch" "$pr" "$project" "$preview"
    done
    ;;
  status)
    if [[ $# -lt 1 ]]; then
      echo "uso: puppy status <pup-id> [--all]" >&2
      exit 1
    fi
    pup_id=""
    all=""
    for arg in "$@"; do
      case "$arg" in
        --all) all="--all" ;;
        *) pup_id="$arg" ;;
      esac
    done
    task_file=$(puppy_find_task "$pup_id" "$all") || exit 1
    jq . "$task_file"
    ;;
  watchers)
    exec "$bin/watchers.sh" "$@"
    ;;
  tell)
    if [[ $# -lt 2 ]]; then
      echo "uso: puppy tell <pup-id> [--all] <text>" >&2
      exit 1
    fi
    pup_id=$1; shift
    all=""
    if [[ "${1:-}" == "--all" ]]; then
      all="--all"
      shift
    fi
    if [[ $# -lt 1 ]]; then
      echo "uso: puppy tell <pup-id> [--all] <text>" >&2
      exit 1
    fi
    task_file=$(puppy_find_task "$pup_id" "$all") || exit 1
    data_dir="$(dirname "$(dirname "$task_file")")"
    pane_id=$(jq -r '.pane_id // empty' "$task_file")
    if [[ -z "$pane_id" ]]; then
      echo "error: no hay pane_id registrado para '$pup_id'" >&2
      exit 1
    fi

    # Same pattern as spawn-pup.sh: confirm the pup actually picked up the
    # message (--wait --until working) before assuming it's off working on
    # it, retrying in case the prompt got lost.
    prompted=0
    for attempt in 1 2 3 4 5; do
      if herdr agent prompt "$pane_id" "$*" --wait --until working --timeout 5000 >/dev/null 2>&1; then
        prompted=1
        break
      fi
      sleep 1
    done
    if [[ "$prompted" -ne 1 ]]; then
      echo "error: el mensaje no llegó a arrancar al pup '$pup_id' en el pane $pane_id tras varios intentos" >&2
      exit 1
    fi

    # The pup's original watcher is single-use and already fired when the
    # pup finished its initial task, so nobody will notice when it's done
    # with this follow-up unless we relaunch one.
    watcher_pid=$(jq -r '.watcher_pid // empty' "$task_file")
    if [[ -n "$watcher_pid" ]] && kill -0 "$watcher_pid" 2>/dev/null; then
      echo "Mensaje enviado a '$pup_id'; ya hay un watcher vivo (pid=$watcher_pid)."
    else
      nohup "$bin/watch-pup.sh" "$pup_id" "$data_dir" >/dev/null 2>&1 &
      new_watcher_pid=$!
      disown

      tmp_file=$(mktemp)
      jq --arg watcher_pid "$new_watcher_pid" '.watcher_pid = ($watcher_pid | tonumber)' "$task_file" > "$tmp_file" && mv "$tmp_file" "$task_file"

      echo "Mensaje enviado a '$pup_id'; watcher relanzado (pid=$new_watcher_pid)."
    fi
    ;;
  usage)
    exec "$bin/usage.sh" "$@"
    ;;
  *)
    cat >&2 <<'EOF'
uso: puppy <comando> [args]

comandos:
  start [project-dir] [--resume|--fresh]              abre (o enfoca) la sesión de puppy para el proyecto dado;
                                                       sin project-dir y en una terminal interactiva, muestra un
                                                       picker con las sesiones conocidas (abiertas o con datos
                                                       guardados) para elegir una o dar una ruta nueva; sin flag
                                                       pregunta si hay sesión previa de ese proyecto que reanudar
  stop [project-dir]                                   termina el proceso de puppy del proyecto dado
                                                       (por defecto el cwd) y cierra su workspace; sin
                                                       project-dir y en una terminal interactiva, muestra
                                                       un picker con las sesiones abiertas para elegir cuál
  forget [project-dir] [--force]                       stop + borra todos los datos guardados del
                                                       proyecto dado (por defecto el cwd): tasks,
                                                       events.log, todo. Avisa si hay pups sin
                                                       terminar (ni done ni merged)
  spawn <pup-id> <repo-path> <branch> <prompt...>   lanza un pup (worktree + worker)
  pr <pup-id> [--all] [-- args de gh pr create]     pushea y abre PR
  rm <pup-id> [--force] [--all]                     borra worktree + registro del pup
  supervise [--all] [pup-id ...]                     espera (sondeo) a que resuelva algún pup
  ls [--all]                                          lista pups registrados + estado de la sesión de puppy
  status <pup-id> [--all]                             muestra la metadata completa de un pup
  watchers                                            lista watch-pup.sh vivos y detecta huérfanos
  tell <pup-id> [--all] <text>                        envía una instrucción de seguimiento a un pup en marcha
  usage                                                muestra el uso de la suscripción Claude Pro (5h/7d)

  Por defecto, los comandos que operan sobre un pup concreto (status, tell,
  pr, rm, supervise) y la tabla de pups de 'ls' solo buscan en el proyecto
  activo de esta sesión; usa --all para buscar en todos los proyectos.
EOF
    exit 1
    ;;
esac
