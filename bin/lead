#!/usr/bin/env bash
set -euo pipefail

# lead — entry point global para herdr-lead, llamable desde cualquier repo.
#
# uso:
#   lead spawn <task-id> <repo-path> <branch> <prompt...>
#   lead pr <task-id> [-- <args extra de gh pr create>]
#   lead rm <task-id> [--force]
#   lead supervise [task-id ...]
#   lead ls
#   lead status <task-id>

lead_dir="$HOME/herdr-lead"
bin="$lead_dir/bin"

cmd="${1:-}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  spawn)
    exec "$bin/spawn-task.sh" "$@"
    ;;
  pr)
    exec "$bin/open-pr.sh" "$@"
    ;;
  rm)
    exec "$bin/remove-worktree.sh" "$@"
    ;;
  supervise)
    exec "$bin/supervise.sh" "$@"
    ;;
  ls)
    tasks_dir="$lead_dir/data/tasks"
    if [[ ! -d "$tasks_dir" ]] || [[ -z "$(ls -A "$tasks_dir" 2>/dev/null)" ]]; then
      echo "No hay tareas registradas."
      exit 0
    fi
    printf "%-20s %-10s %-30s %s\n" "TASK" "ESTADO" "REPO#BRANCH" "CREADA"
    for f in "$tasks_dir"/*.json; do
      jq -r '[.task_id, .status, (.repo | split("/") | last) + "#" + .branch, .created_at] | @tsv' "$f" \
        | awk -F'\t' '{printf "%-20s %-10s %-30s %s\n", $1, $2, $3, $4}'
    done
    ;;
  status)
    if [[ $# -lt 1 ]]; then
      echo "uso: lead status <task-id>" >&2
      exit 1
    fi
    jq . "$lead_dir/data/tasks/$1.json"
    ;;
  *)
    cat >&2 <<'EOF'
uso: lead <comando> [args]

comandos:
  spawn <task-id> <repo-path> <branch> <prompt...>   lanza una tarea (worktree + worker)
  pr <task-id> [-- args de gh pr create]             pushea y abre PR
  rm <task-id> [--force]                             borra worktree + registro de tarea
  supervise [task-id ...]                             espera (sondeo) a que resuelva alguna tarea
  ls                                                   lista tareas registradas y su estado
  status <task-id>                                     muestra la metadata completa de una tarea
EOF
    exit 1
    ;;
esac
